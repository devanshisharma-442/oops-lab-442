#include <bits/stdc++.h>

using namespace std;

class ATM {
    private: int balance;
    int pin;

    public: ATM() {
        balance = 10000;
        pin = 1234;
    }

    bool login() {
        int enteredPin;
        cin >> enteredPin;

        if (enteredPin == pin) {
            cout << "Login Successful!\n";
            return true;
        } else {
            cout << "Incorrect PIN!\n";
            return false;
        }
    }

    void checkBalance() {
        cout << "Current Balance: Rs. " << balance << endl;
    }

    void deposit() {
        int amount;
        cin >> amount;

        if (amount > 0) {
            balance += amount;
            cout << "Amount Deposited Successfully!\n";
            cout << "New Balance: Rs. " << balance << endl;
        } else {
            cout << "Invalid Amount!\n";
        }
    }

    void withdraw() {
        double amount;
        cin >> amount;

        if (amount <= 0) {
            cout << "Invalid Amount!\n";
        }
        else if (amount > balance) {
            cout << "Insufficient Balance!\n";
        }
        else {
            balance -= amount;
            cout << "Please collect your cash.\n";
            cout << "Remaining Balance: Rs. " << balance << endl;
        }
    }

    void changePin() {
        int oldPin, newPin;

        cin >> oldPin;

        if (oldPin == pin) {
            cin >> newPin;
            pin = newPin;
            cout << "PIN Changed Successfully!\n";
        } else {
            cout << "Wrong Current PIN!\n";
        }
    }
};

int main() {
    ATM user;
    int choice;

    if (user.login()==false)
        return 0;

    cin >> choice;

    switch (choice) {
        case 1:
            user.checkBalance();
            break;
        case 2:
            user.deposit();
            break;
        case 3:
            user.withdraw();
            break;
        case 4:
            user.changePin();
            break;
        case 5:
            cout << "Thank You for using the ATM!\n";
            break;
        default:
            cout << "Invalid Choice!\n";
    }

    return 0;
}
